---
import { Picture } from 'astro:assets';
import { featured } from '../data/projects';
import zeylan from '../assets/screens/zeylan.png';
import kivorana from '../assets/screens/kivorana.png';

const screens = { zeylan, kivorana } as const;
const n = featured.length;
const pad = (i: number) => String(i + 1).padStart(2, '0');
---
<section id="work" class="work" aria-labelledby="work-title">
  <!-- With 3D: a pinned viewer whose write-up changes as the Gallery turns. -->
  <div class="viewer">
    <div class="side">
      <h2 class="section-title" id="work-title"><span class="lab">02</span>Selected work</h2>
      <div class="writeups" aria-live="polite">
        {featured.map((p, i) => (
          <article class={`wu${i === 0 ? ' on' : ''}`} data-i={i} id={`wu-${p.id}`} aria-hidden={i === 0 ? undefined : 'true'} inert={i === 0 ? undefined : true}>
            <p class="lab gold">{p.kind}</p>
            <h3>{p.title}</h3>
            {p.paragraphs.map((t) => <p class="body">{t}</p>)}
            <p class="tech">{p.stack.join(' · ')}</p>
            {p.links.length > 0 && <p class="links lab">{p.links.map((l) => <a class="ulink" href={l.href} rel="noopener">{l.label} ↗</a>)}</p>}
          </article>
        ))}
      </div>
      <div class="nav3d" role="group" aria-label="Choose a project">
        <button type="button" class="lab" data-step="-1">← Prev</button>
        <span class="count" aria-hidden="true"><span id="work-count">01</span><small> / {pad(n - 1)}</small></span>
        <button type="button" class="lab" data-step="1">Next →</button>
      </div>
    </div>
    <div class="gview" role="group" tabindex="0" aria-label="Project gallery. Use the left and right arrow keys to change project.">
      <canvas id="gallery-gl" aria-hidden="true"></canvas>
    </div>
  </div>

  <!-- Without 3D: the same projects as plain cards. -->
  <div class="cards">
    <h2 class="section-title rv"><span class="lab">02</span>Selected work</h2>
    <div class="grid">
      {featured.map((p) => (
        <article class="card rv" id={`project-${p.id}`}>
          {p.screen && <Picture src={screens[p.screen]} formats={["avif"]} fallbackFormat="webp" widths={[480, 800, 1200]} sizes="(max-width: 760px) 100vw, 45vw" alt={`Screenshot of ${p.title}`} loading="lazy" decoding="async" />}
          <p class="lab gold">{p.kind}</p>
          <h3>{p.title}</h3>
          {p.paragraphs.map((t) => <p class="body">{t}</p>)}
          <p class="tech">{p.stack.join(' · ')}</p>
          {p.links.length > 0 && <p class="links lab">{p.links.map((l) => <a class="ulink" href={l.href} rel="noopener">{l.label} ↗</a>)}</p>}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .work { position: relative; }
  h3 { font: 300 50px/1 var(--serif); margin: 12px 0 14px; }
  .body { font: 400 15.5px/1.75 var(--sans); color: var(--lede); margin: 0 0 14px; max-width: 48ch; }
  .tech { font: 400 12px/1.7 var(--mono); color: var(--muted); }
  .links { display: flex; gap: 20px; margin-top: 18px; }

  /* 3D viewer (only when the 3D can run) */
  .viewer { display: none; }
  :global(.has3d) .viewer { display: grid; }
  :global(.has3d) .cards { display: none; }
  .viewer { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); align-items: center; gap: 30px; padding: 0 var(--pad); }
  .writeups { position: relative; min-height: 360px; }
  .wu { position: absolute; inset: 0 0 auto 0; opacity: 0; transform: translateY(14px); transition: opacity 0.6s, transform 0.6s; }
  .wu.on { opacity: 1; transform: none; }
  .nav3d { display: flex; align-items: center; gap: 16px; margin-top: 30px; }
  .nav3d button { min-height: 40px; background: none; border: 1px solid var(--line); padding: 10px 14px; cursor: pointer; color: var(--ink); }
  .nav3d button:hover { border-color: var(--gold-text); }
  .count { font: 300 34px/1 var(--sans); letter-spacing: -1px; }
  .count small { font: 400 11px var(--mono); color: var(--muted); letter-spacing: 0; }
  .gview { position: relative; height: 78vh; outline-offset: -2px; }
  .gview canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; cursor: grab; touch-action: pan-y; }
  @media (prefers-reduced-motion: reduce) { .wu { transition: none; } }

  @media (min-width: 761px) {
    /* Desktop: pinned while the ring turns, one project per scroll step */
    :global(.has3d) .work { height: 420vh; }
    :global(.has3d) .viewer { position: sticky; top: 0; height: 100vh; }
  }
  @media (max-width: 760px) {
    :global(.has3d) .viewer { grid-template-columns: 1fr; padding: 10vh var(--pad) 4vh; }
    .gview { height: 300px; order: -1; }
    .writeups { min-height: 420px; }
    h3 { font-size: 42px; }
  }

  /* Fallback cards */
  .cards { padding: 16vh var(--pad) 6vh; }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .card { border: 1px solid var(--rule); background: var(--panel); padding: 24px; }
  .card :global(img) { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; object-position: top; margin-bottom: 18px; border: 1px solid var(--rule); }
  .card h3 { font-size: 36px; margin: 6px 0 10px; }
  @media (max-width: 760px) { .cards { padding: 10vh var(--pad) 4vh; } .grid { grid-template-columns: 1fr; } }
</style>
